{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"], "strict": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "outDir": "dist", "rootDir": "src", "sourceMap": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
